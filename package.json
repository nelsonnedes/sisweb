{
  "type": "module",
  "scripts": {
    "lint": "eslint \"folha_pagamento/**/*.js\" --max-warnings=0",
    "typecheck": "tsc --noEmit --allowJs folha_pagamento/folha-lancamentos.js folha_pagamento/folha-main.js folha_pagamento/folha-filtros.js folha_pagamento/folha-funcionarios.js folha_pagamento/folha-paginacao.js",
    "test": "node --test tests/*.test.mjs",
    "test:security:emulator": "firebase emulators:exec --only database --project demo-sisweb-rbac \"node --test tests/security-rbac-emulator.test.mjs\"",
    "validate:pr": "node scripts/pre-merge-validation.mjs",
    "validate:pr:full": "node scripts/pre-merge-validation.mjs --with-emulator --with-build",
    "smoke:preview": "node tools/smoke-preview-hosting.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting",
    "security:postdeploy": "node tools/security/post-deploy-security-check.mjs",
    "audit:company-logos": "node scripts/audit-company-logos-storage.cjs",
    "migrate:company-logos": "node scripts/migrate-company-logos-to-storage.cjs",
    "test:finance-whitelist": "node test/finance-whitelist-audit.test.mjs --ci"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.33.0",
    "firebase-functions": "^7.3.2",
    "prettier": "^3.6.2",
    "puppeteer": "^25.7.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.7.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
