# Sandbox local — copie para .env.sandbox (não versionar)
SISWEB_ENV=sandbox
GCLOUD_PROJECT=demo-sisweb-sandbox
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-sisweb-sandbox
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Para integração com um projeto Firebase real de sandbox:
# SISWEB_ENV=sandbox
# GCLOUD_PROJECT=sisweb-sandbox-romaneios
# FIREBASE_DATABASE_URL=https://sisweb-sandbox-romaneios-default-rtdb.<região>.firebasedatabase.app
# GOOGLE_APPLICATION_CREDENTIALS=C:\credenciais\sisweb-sandbox.json
