        <!-- ✅ FUNÇÕES CRÍTICAS - CARREGAMENTO PRIORITÁRIO -->
    <script>
        // ⚡ GARANTIR FUNÇÕES CRÍTICAS SEMPRE DISPONÍVEIS
        console.log('🔧 Carregando funções críticas prioritárias...');
        
        // ✅ FUNÇÃO showClientSuggestions - PRIORITÁRIA
        function showClientSuggestions(input) {
            const value = input.value.toLowerCase();
            let suggestionsContainer = document.getElementById('clienteSuggestions');
            
            if (!suggestionsContainer) {
                console.log("Criando container de sugestões");
                suggestionsContainer = document.createElement('div');
                suggestionsContainer.id = 'clienteSuggestions';
                suggestionsContainer.className = 'autocomplete-suggestions';
                suggestionsContainer.style.cssText = `
                    position: absolute;
                    z-index: 1000;
                    background: white;
                    border: 1px solid #ccc;
                    max-height: 200px;
                    overflow-y: auto;
                    display: none;
                `;
                input.parentNode.appendChild(suggestionsContainer);
            }
            
            suggestionsContainer.innerHTML = '';
            suggestionsContainer.style.display = 'none';

            // Verificar se há clientes carregados
            if (typeof window.clients === 'undefined' || !Array.isArray(window.clients)) {
                console.log("Lista de clientes não disponível");
                return;
            }

            if (value.length === 0) {
                // Mostrar os primeiros 5 clientes quando campo vazio
                window.clients.slice(0, 5).forEach(client => {
                    const div = document.createElement('div');
                    div.style.cssText = 'padding: 8px; cursor: pointer; border-bottom: 1px solid #eee;';
                    div.textContent = client.nome || client.name || 'Cliente sem nome';
                    div.addEventListener('click', function() {
                        if (typeof selectClient === 'function') {
                            selectClient(client);
                        } else {
                            input.value = client.nome || client.name;
                        }
                        suggestionsContainer.style.display = 'none';
                    });
                    suggestionsContainer.appendChild(div);
                });
                if (window.clients.length > 0) {
                    suggestionsContainer.style.display = 'block';
                }
                return;
            }

            if (value.length < 2) return;

            // Filtrar clientes
            const filteredClients = window.clients.filter(client => {
                if (!client) return false;
                const name = (client.nome || client.name || '').toLowerCase();
                return name.includes(value);
            });

            if (filteredClients.length === 0) {
                const div = document.createElement('div');
                div.style.cssText = 'padding: 8px; font-style: italic; color: #999;';
                div.textContent = "Nenhum cliente encontrado";
                suggestionsContainer.appendChild(div);
                suggestionsContainer.style.display = 'block';
                return;
            }

            filteredClients.forEach(client => {
                const div = document.createElement('div');
                div.style.cssText = 'padding: 8px; cursor: pointer; border-bottom: 1px solid #eee;';
                div.textContent = client.nome || client.name;
                div.addEventListener('click', function() {
                    if (typeof selectClient === 'function') {
                        selectClient(client);
                    } else {
                        input.value = client.nome || client.name;
                    }
                    suggestionsContainer.style.display = 'none';
                });
                suggestionsContainer.appendChild(div);
            });

            suggestionsContainer.style.display = 'block';
        }
        
        // ✅ FUNÇÃO abrirListaRomaneios - PRIORITÁRIA
        function abrirListaRomaneios() {
            try {
                const modal = document.getElementById('listaModal');
                if (!modal) {
                    alert('Modal de listagem não encontrado no HTML');
                    return;
                }

                const tbody = document.getElementById('listaRomaneios');
                if (!tbody) {
                    alert('Tabela de listagem não encontrada no HTML');
                    return;
                }

                // Limpar tabela
                tbody.innerHTML = '';
                
                // Obter romaneios do localStorage
                let romaneios = [];
                try {
                    const stored = localStorage.getItem('romaneiosPct');
                    romaneios = stored ? JSON.parse(stored) : [];
                } catch (e) {
                    console.error('Erro ao carregar romaneios:', e);
                    romaneios = [];
                }

                console.log("Romaneios encontrados:", romaneios.length);
                
                if (romaneios.length === 0) {
                    const tr = document.createElement('tr');
                    const td = document.createElement('td');
                    td.setAttribute('colspan', '6');
                    td.style.textAlign = 'center';
                    td.style.padding = '20px';
                    td.textContent = 'Nenhum romaneio encontrado';
                    tr.appendChild(td);
                    tbody.appendChild(tr);
                } else {
                    romaneios.forEach((romaneio, index) => {
                        if (!romaneio || typeof romaneio !== 'object') return;
                        
                        const tr = document.createElement('tr');
                        tr.style.backgroundColor = index % 2 === 0 ? '#f9f9f9' : 'white';
                        
                        // Data
                        const tdData = document.createElement('td');
                        tdData.textContent = romaneio.data ? new Date(romaneio.data).toLocaleDateString('pt-BR') : '-';
                        tr.appendChild(tdData);
                        
                        // Cliente
                        const tdCliente = document.createElement('td');
                        tdCliente.textContent = romaneio.cliente ? 
                            (romaneio.cliente.nome || romaneio.cliente.name || 'N/A') : 'N/A';
                        tr.appendChild(tdCliente);
                        
                        // Espécie
                        const tdEspecie = document.createElement('td');
                        if (romaneio.itens && Array.isArray(romaneio.itens)) {
                            const especies = romaneio.itens
                                .filter(item => item && item.especie)
                                .map(item => item.especie)
                                .filter((v, i, a) => a.indexOf(v) === i);
                            tdEspecie.textContent = especies.join(', ') || '-';
                        } else {
                            tdEspecie.textContent = '-';
                        }
                        tr.appendChild(tdEspecie);
                        
                        // Volume
                        const tdVolume = document.createElement('td');
                        const volume = romaneio.totalVolume || (romaneio.totais && romaneio.totais.volume) || 0;
                        tdVolume.textContent = parseFloat(volume).toFixed(3) + ' m³';
                        tr.appendChild(tdVolume);
                        
                        // Valor
                        const tdValor = document.createElement('td');
                        const valor = romaneio.totalValor || (romaneio.totais && romaneio.totais.valor) || 0;
                        tdValor.textContent = 'R$ ' + parseFloat(valor).toFixed(2);
                        tr.appendChild(tdValor);
                        
                        // Ações
                        const tdAcoes = document.createElement('td');
                        
                        const btnCarregar = document.createElement('button');
                        btnCarregar.textContent = '⬇ Carregar';
                        btnCarregar.style.cssText = 'margin-right: 5px; padding: 4px 8px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;';
                        btnCarregar.onclick = () => {
                            if (typeof carregarRomaneio === 'function') {
                                carregarRomaneio(index);
                            } else {
                                alert('Função carregarRomaneio não disponível');
                            }
                            modal.style.display = 'none';
                        };
                        
                        const btnExcluir = document.createElement('button');
                        btnExcluir.textContent = '🗑 Excluir';
                        btnExcluir.style.cssText = 'padding: 4px 8px; background: #dc3545; color: white; border: none; border-radius: 3px; cursor: pointer;';
                        btnExcluir.onclick = () => {
                            if (confirm('Tem certeza que deseja excluir este romaneio?')) {
                                romaneios.splice(index, 1);
                                localStorage.setItem('romaneiosPct', JSON.stringify(romaneios));
                                abrirListaRomaneios(); // Recarregar
                            }
                        };
                        
                        tdAcoes.appendChild(btnCarregar);
                        tdAcoes.appendChild(btnExcluir);
                        tr.appendChild(tdAcoes);
                        
                        tbody.appendChild(tr);
                    });
                }
                
                // Exibir modal
                modal.style.display = 'block';
                console.log("Modal de romaneios aberto com", romaneios.length, "itens");
                
            } catch (error) {
                console.error("Erro ao abrir lista de romaneios:", error);
                alert('Erro ao abrir lista: ' + error.message);
            }
        }
        
        // ✅ FUNÇÃO openSpeciesListModal - PRIORITÁRIA (FALLBACK)
        function openSpeciesListModal() {
            console.log('🌿 openSpeciesListModal (fallback) chamado');
            
            // Aguardar o sistema unificado estar disponível
            if (window.speciesManagerInstance && typeof window.speciesManagerInstance.openModal === 'function') {
                return window.speciesManagerInstance.openModal();
            }
            
            // Verificar se existe modal básico no HTML
            const modal = document.getElementById('speciesListModal');
            if (modal) {
                console.log('📋 Abrindo modal básico de espécies');
                modal.style.display = 'block';
                
                // Carregar espécies se necessário
                if (typeof carregarEspecies === 'function') {
                    carregarEspecies();
                }
                return;
            }
            
            // Fallback com alerta
            alert('Sistema de espécies não está disponível. Recarregue a página.');
        }
        
        // ✅ EXPOR FUNÇÕES GLOBALMENTE
        window.showClientSuggestions = showClientSuggestions;
        window.abrirListaRomaneios = abrirListaRomaneios;
        window.openSpeciesListModal = openSpeciesListModal;
        
        console.log('✅ Funções críticas carregadas e expostas globalmente');
        console.log('- showClientSuggestions:', typeof showClientSuggestions);
        console.log('- abrirListaRomaneios:', typeof abrirListaRomaneios);
        console.log('- openSpeciesListModal:', typeof openSpeciesListModal);
    </script>

    <!-- ✅ SISTEMA UNIFICADO CARREGADO VIA SCRIPTS DIRETOS ACIMA -->
    <script>
        // ✅ VALIDAÇÃO FINAL DO SISTEMA UNIFICADO
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🎯 Validando sistema unificado carregado...');
            
            setTimeout(() => {
                const funcoesCriticas = [
                    'adicionarItem',
                    'salvarRomaneio', 
                    'imprimirRomaneio',
                    'calcularVolumePCT',
                    'calcularTotalPecasPCT',
                    'abrirListaRomaneios',
                    'showClientSuggestions',
                    'openSpeciesListModal'
                ];
                
                const funcionesDisponveis = funcoesCriticas.filter(f => typeof window[f] === 'function');
                const funcionesFaltando = funcoesCriticas.filter(f => typeof window[f] !== 'function');
                
                console.log(`📊 Sistema Unificado: ${funcionesDisponveis.length}/${funcoesCriticas.length} funções disponíveis`);
                console.log('✅ Funções disponíveis:', funcionesDisponveis);
                
                if (funcionesFaltando.length > 0) {
                    console.warn('⚠️ Funções não disponíveis:', funcionesFaltando);
                } else {
                    console.log('🎉 Sistema Romaneiopct Unificado totalmente operacional!');
                }
                
                // Validar campo específico PCT
                const campoPecasPorPacote = document.getElementById('pecasPorPacote');
                if (campoPecasPorPacote) {
                    console.log('✅ Campo pecasPorPacote encontrado');
                    // Garantir valor padrão
                    if (!campoPecasPorPacote.value) {
                        campoPecasPorPacote.value = '1';
                    }
                } else {
                    console.warn('⚠️ Campo pecasPorPacote não encontrado');
                }
                
                // Executar validação do sistema se disponível
                if (typeof window.validarSistemaPCT === 'function') {
                    const resultadoValidacao = window.validarSistemaPCT();
                    console.log('📋 Resultado da validação:', resultadoValidacao);
                }
                
            }, 1000);
        });
    </script>
    
        <!-- Sistema de monitoramento INTELIGENTE -->
    <script>
        // Aguardar sistema estar totalmente carregado antes de monitorar
        let sistemaCarregado = false;
        let tentativasVerificacao = 0;
        const MAX_TENTATIVAS = 10;
        
        // Verificar se sistema foi carregado
        function verificarSistemaCarregado() {
            if (window.SISTEMA_MODULAR_PCT_CARREGADO) {
                sistemaCarregado = true;
                console.log('🎯 Sistema modular confirmado como carregado');
                iniciarMonitoramento();
                return;
            }
            
            tentativasVerificacao++;
            if (tentativasVerificacao < MAX_TENTATIVAS) {
                setTimeout(verificarSistemaCarregado, 2000);
            } else {
                console.warn('⚠️ Sistema pode não ter carregado completamente');
            }
        }
        
        function iniciarMonitoramento() {
            console.log('🔍 Iniciando monitoramento do sistema PCT');
            
            // Monitoramento de erros nos módulos
            window.addEventListener('error', function(event) {
                if (event.filename && event.filename.includes('modules/romaneiopct/')) {
                    console.error('🚨 ERRO EM MÓDULO PCT:', event.error);
                    
                    console.log('📝 Detalhes do erro:', {
                        arquivo: event.filename,
                        linha: event.lineno,
                        coluna: event.colno,
                        erro: event.error.message
                    });
                }
            });
            
            // Verificação periódica INTELIGENTE (apenas se sistema carregado)
            setInterval(() => {
                if (sistemaCarregado) {
                    const funcoesPCT = Object.keys(window).filter(k => k.includes('PCT'));
                    if (funcoesPCT.length === 0) {
                        console.warn('⚠️ Nenhuma função PCT encontrada - possível problema');
                    }
                    // Remover verificação específica que causava alerta falso
                }
            }, 60000); // 1 minuto (mais espaçado)
        }
        
        // Iniciar verificação após DOM carregado
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(verificarSistemaCarregado, 3000); // 3 segundos após DOM
        });
    </script>
</body>
</html>
