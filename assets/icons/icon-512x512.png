<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <!-- Background -->
  <rect width="192" height="192" rx="20" fill="#2c5aa0"/>
  
  <!-- Decorative gradient overlay -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3498db;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#1e3a8a;stop-opacity:0.1"/>
    </linearGradient>
  </defs>
  <rect width="192" height="192" rx="20" fill="url(#grad1)"/>
  
  <!-- Main icon - Document/Romaneio -->
  <g transform="translate(32, 24)">
    <!-- Document background -->
    <rect x="16" y="16" width="96" height="120" rx="6" fill="#ffffff" stroke="#e5e7eb" stroke-width="2"/>
    
    <!-- Document header -->
    <rect x="16" y="16" width="96" height="24" rx="6" fill="#f3f4f6"/>
    
    <!-- SisWeb logo text -->
    <text x="64" y="32" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2c5aa0">SisWeb</text>
    
    <!-- Document lines -->
    <rect x="24" y="48" width="80" height="2" fill="#d1d5db"/>
    <rect x="24" y="56" width="60" height="2" fill="#d1d5db"/>
    <rect x="24" y="64" width="70" height="2" fill="#d1d5db"/>
    
    <!-- Table/Grid representation -->
    <g transform="translate(24, 76)">
      <!-- Header row -->
      <rect x="0" y="0" width="80" height="12" fill="#f9fafb" stroke="#e5e7eb"/>
      
      <!-- Data rows -->
      <rect x="0" y="12" width="80" height="8" fill="#ffffff" stroke="#e5e7eb"/>
      <rect x="0" y="20" width="80" height="8" fill="#f9fafb" stroke="#e5e7eb"/>
      <rect x="0" y="28" width="80" height="8" fill="#ffffff" stroke="#e5e7eb"/>
      <rect x="0" y="36" width="80" height="8" fill="#f9fafb" stroke="#e5e7eb"/>
      
      <!-- Vertical lines for columns -->
      <line x1="20" y1="0" x2="20" y2="44" stroke="#e5e7eb"/>
      <line x1="40" y1="0" x2="40" y2="44" stroke="#e5e7eb"/>
      <line x1="60" y1="0" x2="60" y2="44" stroke="#e5e7eb"/>
    </g>
    
    <!-- Wood/Tree icon in corner -->
    <g transform="translate(88, 120)">
      <circle cx="12" cy="8" r="8" fill="#10b981" opacity="0.8"/>
      <rect x="10" y="16" width="4" height="12" fill="#8b5cf6"/>
    </g>
  </g>
  
  <!-- Bottom accent -->
  <rect x="0" y="172" width="192" height="20" rx="0 0 20 20" fill="#1e3a8a" opacity="0.1"/>
</svg> 